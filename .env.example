# ═══════════════════════════════════════════════════════════════
#  Fatigue Monitoring System — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
#  DATABASE
# ──────────────────────────────────────────────────────────────
# Local SQLite (Development)
DATABASE_URL=sqlite:///./fatigue.db

# Neon DB (PostgreSQL Production)
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
# DATABASE_URL=postgresql://neondb_owner:npg_...subdomain.neon.tech/neondb?sslmode=require

# ──────────────────────────────────────────────────────────────
#  SECURITY
# ──────────────────────────────────────────────────────────────
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=9a6e3556012c75a4d468b8b4b7c89f07a6d5c4b3a2f1e0d9c8b7a69584736251

# JWT Algorithm (Default: HS256)
ALGORITHM=HS256

# Token expiration (in minutes). Default: 1440 (24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ──────────────────────────────────────────────────────────────
#  TIMEZONE (SYSTEM CONSTANT)
# ──────────────────────────────────────────────────────────────
# The system is standardized to IST (India Standard Time, UTC +5:30).
# All database logs and timers utilize this timezone.
# ──────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────
#  FRONTEND / API
# ──────────────────────────────────────────────────────────────
# Backend API URL (Default local)
VITE_API_URL=http://localhost:8000
