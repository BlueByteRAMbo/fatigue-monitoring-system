# ═══════════════════════════════════════════════════════════════
#  Fatigue Monitoring System — Root .gitignore
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
#  PYTHON / BACKEND
# ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Secrets & environment
.env
.envrc
*.env.local

# SQLite database files (dev only; never commit production data)
*.db
*.sqlite3
*.sqlite3-journal
fatigue.db

# Distribution / build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/
MANIFEST
sdist/
wheels/
share/python-wheels/
.installed.cfg

# Test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Installer / packaging logs
pip-log.txt
pip-delete-this-directory.txt

# Misc Python tooling
.ruff_cache/
.pypirc
.pdm-python
.pdm-build/
.pixi
__pypackages__/
celerybeat-schedule
celerybeat.pid
*.sage.py
*.manifest
*.spec

# ──────────────────────────────────────────────────────────────
#  NODE / REACT DASHBOARD
# ──────────────────────────────────────────────────────────────
node_modules/
dashboard/node_modules/
dashboard/dist/
dashboard/.env
dashboard/.env.local
dashboard/.env.*.local

# Vite / build outputs
dist/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories / files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ──────────────────────────────────────────────────────────────
#  CHROME EXTENSION
# ──────────────────────────────────────────────────────────────
# The extension ships as plain files — nothing to ignore except:
extension/.env

# ──────────────────────────────────────────────────────────────
#  ML MODEL
# ──────────────────────────────────────────────────────────────
# Large binary model files are tracked via Git LFS.
# If you are NOT using LFS, uncomment the next line to keep them
# out of regular Git history:
# model/*.pkl

# Notebook outputs / checkpoints
notebooks/.ipynb_checkpoints/
notebooks/**/.ipynb_checkpoints/
notebooks/**/__pycache__/

# ──────────────────────────────────────────────────────────────
#  MISC / AI TOOLS
# ──────────────────────────────────────────────────────────────
.cursorignore
.cursorindexingignore
.abstra/
marimo/_static/
marimo/_lsp/
__marimo__/