{
  "manifest_version": 3,
  "name": "Fatigue Monitoring Client",
  "version": "1.0.0",
  "description": "Monitors student fatigue levels in real-time during virtual classes.",
  "permissions": [
    "storage",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "https://fatigue-monitoring-system-api.onrender.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fatigue Monitor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
